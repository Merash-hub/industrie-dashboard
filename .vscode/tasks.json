{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/IndustrieDashboard.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/IndustrieDashboard.sln"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            // Erzeugt eine eigenstaendige IndustrieDashboard.exe, die ohne
            // installiertes .NET per Doppelklick laeuft.
            "label": "eigenstaendige exe erstellen",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/IndustrieDashboard.App",
                "-c", "Release",
                "-r", "win-x64",
                "--self-contained", "true",
                "-p:PublishSingleFile=true",
                "-p:IncludeNativeLibrariesForSelfExtract=true"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
