<UserControl x:Class="IndustrieDashboard.Modules.Maschinenueberwachung.Views.MaschinenueberwachungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mvvm="clr-namespace:IndustrieDashboard.Shared.Mvvm;assembly=IndustrieDashboard.Shared"
             d:DataContext="{d:DesignInstance Type=mvvm:PlatzhalterViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid Margin="24">
        <materialDesign:Card Padding="24" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Gauge" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Titel}" FontSize="22" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource MaterialDesignChipBackground}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="In Entwicklung" FontSize="11" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Beschreibung}" Margin="0,12,0,16" TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock Text="Geplante Funktionen:" FontWeight="Medium" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding GeplanteFunktionen}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.6" />
                                <TextBlock Text="{Binding}" Margin="4,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
