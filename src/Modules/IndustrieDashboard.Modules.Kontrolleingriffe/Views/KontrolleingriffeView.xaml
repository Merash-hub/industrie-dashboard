<UserControl x:Class="IndustrieDashboard.Modules.Kontrolleingriffe.Views.KontrolleingriffeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:IndustrieDashboard.Modules.Kontrolleingriffe.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:KontrolleingriffeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{materialDesign:MaterialDesignFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolZuSichtbarkeit" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="28" Height="28" VerticalAlignment="Center" />
            <TextBlock Text="Kontrolleingriffe" FontSize="24" FontWeight="Medium" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Kopfzeile: Benutzerwechsel (Prototyp-Ersatz für eine echte Anmeldung) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,16" VerticalAlignment="Center">
            <TextBlock Text="Angemeldet als:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding VerfuegbareBenutzer}"
                      SelectedItem="{Binding AktuellerBenutzer}"
                      MinWidth="220"
                      Margin="8,0,0,0" />
            <TextBlock Text="Prototyp: Benutzerwechsel ersetzt später die Anmeldung über Active Directory."
                       FontStyle="Italic" FontSize="11" Opacity="0.6"
                       VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
            <Button Content="Aktualisieren"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding AktualisierenCommand}"
                    Margin="16,0,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusMeldung}" Margin="0,0,0,16" TextWrapping="Wrap" FontSize="12" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Offene Anforderungen -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Offene Anforderungen" FontWeight="Medium" Margin="0,0,0,8" />

                <TextBlock Text="Aktuell keine offenen Anforderungen."
                           FontStyle="Italic" Opacity="0.6" Margin="0,0,0,8"
                           Visibility="{Binding KeineOffenenAnforderungen, Converter={StaticResource BoolZuSichtbarkeit}}" />

                <ItemsControl ItemsSource="{Binding OffeneAnforderungen}"
                              Visibility="{Binding OffeneAnforderungenVorhanden, Converter={StaticResource BoolZuSichtbarkeit}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,16,16" Padding="16" Width="300"
                                                 materialDesign:ElevationAssist.Elevation="Dp2">
                                <StackPanel>
                                    <TextBlock Text="{Binding MaschineAnzeige}" FontWeight="Medium" FontSize="16" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Beschreibung}" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.8" />
                                    <TextBlock Margin="0,8,0,0" FontSize="12" Opacity="0.7" TextWrapping="Wrap">
                                        <Run Text="Angefordert von" />
                                        <Run Text="{Binding AngefordertVon, Mode=OneWay}" FontWeight="Medium" />
                                        <Run Text="am" />
                                        <Run Text="{Binding AngefordertAm, Mode=OneWay, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="Freigeben"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Command="{Binding DataContext.FreigebenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DarfFreigeben}"
                                                ToolTip="{Binding FreigabeHinweis}" />
                                        <Button Content="Ablehnen"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Command="{Binding DataContext.AblehnenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Audit-Trail -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="Audit-Trail (letzte 100 Einträge)" FontWeight="Medium" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding AuditEintraege}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          materialDesign:DataGridAssist.CellPadding="8,6"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zeitstempel" Binding="{Binding Zeitstempel, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150" />
                        <DataGridTextColumn Header="Benutzer" Binding="{Binding Benutzer}" Width="200" />
                        <DataGridTextColumn Header="Aktion" Binding="{Binding Aktion}" Width="180" />
                        <DataGridTextColumn Header="Zielobjekt" Binding="{Binding Zielobjekt}" Width="150" />
                        <DataGridTextColumn Header="Begründung" Binding="{Binding Begruendung}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
